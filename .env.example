# 제주데이터허브 Open API
JEJU_HUB_PROJECT_KEY=여기에_프로젝트_키
JEJU_HUB_BASE_URL=https://open.jejudatahub.net/api/proxy

# LLM (선택) — 비워두면 설명 생성은 템플릿만 사용(버튼 경로는 LLM 없이 완전 동작)
LLM_PROVIDER=none          # none | openai | ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=exaone3.5:7.8b

# 데이터 캐시
DATA_DIR=./data/cache
